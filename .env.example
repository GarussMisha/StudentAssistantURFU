# PostgreSQL — одна строка для приложения
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/db_name

# PostgreSQL — три переменные для старта контейнера
POSTGRES_USER=postgres_user
POSTGRES_PASSWORD=postgres_pass
POSTGRES_DB=db_name

# Qdrant
QDRANT_URL=http://qdrant:6333

# LLM (провайдер: local = LM Studio, openrouter = OpenRouter)
LLM_PROVIDER=local
LLM_BASE_URL=http://host.docker.internal:1234/v1
LLM_API_KEY=none_key
LLM_MODEL=qwen2.5-coder-3b-instruct

# Embedding
EMBEDDING_PROVIDER=local
EMBEDDING_BASE_URL=http://host.docker.internal:1234/v1/embeddings
EMBEDDING_MODEL=text-embedding-qwen3-embedding-0.6b

# Корпус БЗ
KB_DATA_DIR=/data/kb

# Сессии и лимиты
SESSION_TTL_DAYS=7
RATE_LIMIT_PER_HOUR=100

# Админ (только для первого запуска)
ADMIN_EMAIL=admin@urfu.ru
ADMIN_PASSWORD=pass1234
